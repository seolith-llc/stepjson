{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/seolith-llc/stepjson/main/schema/1.0/choreo.schema.json",
  "title": "StepJSON choreography document",
  "description": "The compositional layer: a sequence that references steps by id rather than embedding them. See stepjson-spec.md §7.",
  "type": "object",
  "additionalProperties": false,
  "required": ["choreojson", "id", "title", "createdAt", "entries", "transitionBeats"],
  "properties": {
    "choreojson": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "author": { "type": "string", "minLength": 1, "maxLength": 60, "default": "anonymous" },
    "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "license": {
      "enum": ["proprietary", "cc-by-4.0", "public-domain", "work-for-hire"],
      "default": "proprietary"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/definitions/entry" }
    },
    "transitionBeats": {
      "type": "number",
      "minimum": 0,
      "maximum": 4,
      "description": "Cross-fade length at segment boundaries; 0 = hard cuts."
    },
    "musicRef": { "type": "string", "pattern": "^[a-z0-9-]+$" }
  },
  "definitions": {
    "vec2": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "repeats", "tempoPct"],
      "properties": {
        "stepId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "repeats": { "type": "integer", "minimum": 1, "maximum": 16 },
        "tempoPct": { "type": "integer", "minimum": 50, "maximum": 150 },
        "facingOverride": { "enum": ["front", "left", "right", "back"] },
        "mirror": { "type": "boolean" },
        "poseOverlay": {
          "type": "object",
          "additionalProperties": false,
          "description": "Merged into every keyframe of this entry's step.",
          "properties": {
            "nose": { "$ref": "#/definitions/vec2" },
            "leftEye": { "$ref": "#/definitions/vec2" },
            "rightEye": { "$ref": "#/definitions/vec2" },
            "leftEar": { "$ref": "#/definitions/vec2" },
            "rightEar": { "$ref": "#/definitions/vec2" },
            "leftShoulder": { "$ref": "#/definitions/vec2" },
            "rightShoulder": { "$ref": "#/definitions/vec2" },
            "leftElbow": { "$ref": "#/definitions/vec2" },
            "rightElbow": { "$ref": "#/definitions/vec2" },
            "leftWrist": { "$ref": "#/definitions/vec2" },
            "rightWrist": { "$ref": "#/definitions/vec2" },
            "leftHip": { "$ref": "#/definitions/vec2" },
            "rightHip": { "$ref": "#/definitions/vec2" },
            "leftKnee": { "$ref": "#/definitions/vec2" },
            "rightKnee": { "$ref": "#/definitions/vec2" },
            "leftAnkle": { "$ref": "#/definitions/vec2" },
            "rightAnkle": { "$ref": "#/definitions/vec2" },
            "leftFootIndex": { "$ref": "#/definitions/vec2" },
            "rightFootIndex": { "$ref": "#/definitions/vec2" }
          }
        }
      }
    }
  }
}
